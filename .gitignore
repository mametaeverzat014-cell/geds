# Data
data/raw/
data/processed/
data/replay/*.parquet
data/replay/*.arrow
*.csv
!data/fixtures/*.csv

# GEDS data layer — these CSVs ARE source of truth, must be committed.
# Override the *.csv blanket rule above.
!backend/data/csv/
!backend/data/csv/**/*.csv

# Comtrade raw cache — regenerated by scripts/fetch_comtrade.py.
backend/data/raw/comtrade/*.parquet
backend/data/raw/comtrade/*.log

# Other ephemerals not part of the audit trail
backend/data/calibration/study.db
backend/data/grok_cache/
backend/data/news_cache/
backend/data/ml_dataset/

# Simulation outputs
simulations/results/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Docker
*.pid

# Notebooks (keep .ipynb in ml/notebooks; ignore checkpoints)
.ipynb_checkpoints/

# Local infra state
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup

# === Deploy hygiene (stabilization) ===
# 1.5 GB of OECD/WIOD/Comtrade raw inputs + scratch dumps live under
# backend/data/raw/. The earlier `data/raw/` rule is root-anchored and does NOT
# match backend/data/raw/, so this was leaking into `git add`. Regenerated by
# backend/scripts/*; never belongs in git.
backend/data/raw/
# Oversized derived edge tables: exceed GitHub's 100 MB push limit and are NOT
# read by the runtime app (it loads the small registry/evidence CSVs). Keep out.
backend/data/csv/oecd_icio_edges.csv
backend/data/csv/wiod_edges.csv

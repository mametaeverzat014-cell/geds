# Copy this file to .env.local for local dev (.env.local is gitignored by default).
# For Vercel, set these in: Project Settings → Environment Variables.

# Point at your deployed Render backend in production:
NEXT_PUBLIC_API_URL=https://geds-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://geds-backend.onrender.com

# For local dev against your local backend:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
